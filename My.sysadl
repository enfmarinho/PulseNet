Model SysADLModel ; 

package newElement { }
	
Requirement Requisitos ( 8 ) {
	
	Requirement RequisitosNaoFuncionais ( 10 ) {
		
		Requirement SegurancaNFR ( 46 ) { text = "Garante que o sistema é seguro "
			Requirement AuditoriaNFR ( 49 ) {
				text = "Todas as acoes de usuarios e alertas devem ser registradas com timestamp, ID do usuario e origem."
			}
			Requirement AutenticacaoNFR ( 45 ) {
				text = "Somente usuarios autenticados podem acessar dados do paciente."
			}
			Requirement CripitografiaDosDadosNFR ( 48 ) {
				text = "Dados de pacientes devem ser armazenados de forma criptografada."
			}
			Requirement AutorizacaoNFR ( 47 ) {
				text = "Funcoes sensıveis, como alteracao de leitos, devem seguir nıvel de permissao da equipe medica."
			}
		}
		
		Requirement ConfiabilidadeNFR ( 50 ) { text = "Garante que o sistema é confiavel"
			Requirement TaxaMaximaDeFalhasNFR ( 51 ) {
				text = "O sistema deve operar com taxa de falhas recuperaveis inferior a 0,1%\ndas mensagens."
			}
			Requirement IntegridadeDosDadosNFR ( 52 ) {
				text = "Nenhuma leitura de sinal vital pode ser descartada sem log ou justificativa."
			}
			Requirement DetecaoDeFalhasNFR ( 53 ) {
				text = "Monitores devem enviar heartbeats; falhas devem ser detectadas em ≤ 10\nsegundos"
			}
		}
		
		Requirement DisponibilidadeNFR ( 34 ) { text = "Garante que o sistema está sempre funcionado e disponível"
			Requirement RetentativaDeEnvioNFR ( 37 ) {
				text = "Se a mensagem do sensor nao for entregue, o sistema deve reenviar a leitura ate um limite configurado."
			}
			Requirement BufferLocalNoLeitoNFR ( 38 ) {
				text = "Ao perder comunicacao com a rede, o monitor do leito deve armazenar localmente dados por no mınimo 5 minutos."
			}
			Requirement DisponibilidadeDoSistemaNFR ( 35 ) {
				text = "O sistema deve manter disponibilidade contınua mınima de 99,5%, garantindo\nmonitoramento ininterrupto."
			}
			Requirement MensageriaConfiavelNFR ( 39 ) {
				text = "A mensageria deve enviar apenas mensagens validas "
			}
			Requirement FallbackDeColetaNFR ( 36 ) {
				text = "Caso o coletor principal falhe, um coletor de fallback deve assumir automaticamente a captura dos dados do leito."
			}
		}
		
		Requirement EscalabilidadeDesempenhoNFR ( 40 ) { text = "Garante que o sistema é escalável e eficiente"
			Requirement EscalabilidadeHorizontalNFR ( 41 ) {
				text = "Os servicos de mensageria, alerta e dashboard devem suportar instancias multiplas em balanceamento de carga."
			}
			Requirement AumentoDeLeitosNFR ( 42 ) {
				text = "A arquitetura deve permitir crescimento para 3× o numero atual de leitos sem redesenho estrutural"
			}
			Requirement ProcessamentoEmFilaNFR ( 43 ) {
				text = "A solucao deve processar picos de mensagens sem perda, suportando ao menos 300 mensagens/s por enfermaria"
			}
			Requirement AcessoRapidoAosDadosNFR ( 44 ) {
				text = "Os dados e alertas devem estar disponiveis no sistema rapidamente"
			}
		}
		
		Requirement ModificabilidadeManutenibilidadeNFR ( 32 ) { text = "Garante que o sistema é de fácil manutencão e fácil de modificar e atualizar"
			Requirement ModularidadeNFR ( 33 ) {
				text = "Sensores, coletores, servicos e dashboards devem ser substituıveis sem impacto nas demais camadas. A logica medica deve ser isolada em um componente especıfico, permitindo alteracao sem modificar a infraestrutura."
			}
		}
		
		Requirement UsabilidadeNFR ( 56 ) { text = "Garante que o sistema é de fácil uso"
			Requirement AcessibilidadeNFR ( 55 ) {
				text = "Dashboard com contraste alto, teclas de atalho e sem dependencia exclu-\nsiva de cores."
			}
			Requirement InterfaceIntuitivaNFR ( 54 ) {
				text = "O dashboard deve exibir informacoes prioritarias com foco em situacao crıtica"
			}
		}
	}
	
	
	Requirement RequisitosFuncionais ( 9 ) {
		
		Requirement ColetaSinaisVitaisFR ( 7 ) {
			text = "Ler e agrupa os sinais vitais do paciente" 
			
			Requirement ColetarEletrocardiogramaFR ( 4 ) {
				text = "O sistema deve coletar dados de sensores de eletrocardiograma com periodicidade mınima de uma vez por segundo. "
			}
			Requirement ColetarOxigenacaoSanguineaFR ( 3 ) {
				text = "O sistema deve coletar dados de sensores de oxigenacao sanguınea com periodicidade mınima de uma vez por segundo. "
			}
			Requirement ColetarFrequenciaCardiacaFR ( 1 ) {
				text = "O sistema deve coletar dados de sensores de frequencia cardıaca com periodicidade mınima de uma vez por segundo."
			}
			Requirement ColetarPressaoArterialFR ( 2 ) {
				text = "O sistema deve coletar dados de sensores de pressao arterial com periodicidade mınima de uma vez por segundo. "
			}
			Requirement ColetarTemperaturaCorporalFR ( 5 ) {
				text = "O sistema deve coletar dados de sensores de temperatura corporal com periodicidade mınima de uma vez por segundo. Requisito opcional, mas comum em unidades de terapia intensiva. "
			}
			Requirement RegistrarTimestandDaLeituraFR ( 6 ) {
				text = "O sistema deve registrar o timestamp de cada leitura realizada pelos sensores para garantir rastreabilidade e ordenacao cronologica dos dados. "
			}
		}
		
		Requirement TransmissaoDadosDosLeitoFR ( 11 ) {
			Requirement EnviarDadosDoSensorParaColetorFR ( 12 ) {
				text = "Cada sensor deve enviar suas leituras para o coletor com uma periodicidade de no mınimo uma vez por segundo."
			}
			Requirement ReenviarDadosEmCasoDeFalhaFR ( 14 ) {
				text = "Em caso de falha de um coletor, o sistema deve ter um mecanismo de fallback automatico, garantindo a continuidade da operacao de ingestao de dados. Os dados devem ser reenviados automaticamente quando a conexao for restabelecida."
			}
			Requirement ValidarFormatoDaMensagemDoSensorFR ( 13 ) {
				text = "O sistema deve validar o formato da mensagem recebida do sensor antes\ndo processamento, garantindo integridade e conformidade com o protocolo definido."
			}
			Requirement GarantirOrdemCronologicaDaTransmissaoFR ( 15 ) {
				text = "O sistema deve garantir que os dados sejam transmitidos e processados\nmantendo a ordem cronologica das leituras, preservando a sequencia temporal dos eventos."
			}
		}
		
		Requirement ProcessamentoDeDadosFR ( 16 ) { text = "Processsa, salva e lê os sinais vitais dos pacientes"
			Requirement NormalizarDadosDeSinaisVitaisFR ( 17 ) {
				text = "O coletor deve normalizar os dados de sinais vitais recebidos dos sensores, padronizando formatos e unidades de medida para processamento uniforme"
			}
			Requirement ConsumirDadosDaFilaFR ( 20 ) {
				text = "A arquitetura da mensageria deve gerenciar o paralelismo interno para processar multiplos streams de dados simultaneamente, evitando gargalos. Os gateways devem consumir dados da fila de forma eficiente."
			}
			Requirement PersistirDadosNoBancoFR ( 21 ) {
				text = "O sistema deve persistir todas as leituras de sinais vitais no banco de dados para historico, analise e auditoria, garantindo integridade e disponibilidade dos dados."
			}
			Requirement ArmazenarLeituraEmBufferSeguroFR ( 18 ) {
				text = "O coletor deve processar dados em tempo real, com latencia maxima de\n500ms da leitura do sensor ate o processamento inicial. Os dados devem ser armazenados temporariamente em buffer seguro durante o processamento."
			}
			Requirement PublicarLeituraNaFilaDeMensageriaFR ( 19 ) {
				text = "A mensageria deve agrupar sensores em clusters de alto volume (Cluster 1) e clusters de baixa carga (Cluster 2) para otimizacao do fluxo de dados. Cada sensor deve publicar seus dados em topicos especıficos, utilizando uma chave de leitura para identificacao e roteamento"
			}
		}
		
		Requirement AvaliacaoClinicaFR ( 22 ) { text = "O sistema deve ser capaz de avaliar o paciente automaticamente"
			Requirement DetectarLimiarDeRiscoFR ( 23 ) {
				text = "A Logica Medica deve avaliar os criterios de medicao e detectar condicoes crıticas baseadas nos limiares calculados e nas leituras dos sensores."
			}
			Requirement GerarAlertaClinicoAutomaticoFR ( 24 ) {
				text = "O Servico de Alerta deve monitorar as leituras dos sensores e emitir alertas em menos de 1 segundo apos a deteccao de uma leitura criıtica. O servico deve suportar fallback em caso de falha, garantindo que a emissao de alertas nao seja interrompida."
			}
			Requirement EnviarComandoDeAlertaParaDispositivosFR ( 25 ) {
				text = "O sistema deve enviar comandos para acionar LEDs e alarmes sonoros que indiquem o estado do paciente, baseado na classificacao do alerta gerado."
			}
		}
		
		Requirement MonitorDoLeitoFR ( 27 ) { text = "Os sinais vitais do paciente devem ser exibidos no monitor"
			Requirement ExibirDadosEmTempoRealNoMonitoFR ( 26 ) {
				text = "O Monitor do Leito deve exibir os dados de todos os sensores em tempo real, com uma taxa de atualizacao de no mınimo 200ms, permitindo acompanhamento contınuo do estado do paciente."
			}
		}
		
		Requirement InterfaceGraficaFR ( 28 ) { text = "O sistema deve exibir os dados e alertas dos pacientes em tempo real"
			Requirement ExibirAlertasEmTempoRealFR ( 31 ) {
				text = "O dashboard deve exibir alertas em tempo real, destacando visualmente os alertas crıticos e de atencao, com informacoes sobre o leito, paciente e tipo de alerta."
			}
			Requirement ListarHistoricoDeSinaisVitaisFR ( 30 ) {
				text = "O sistema deve permitir a visualizacao do historico de sinais vitais de cada paciente, com filtros por data, hora e tipo de sinal, facilitando analise retrospectiva."
			}
			Requirement ExibirDadosEmTempoRealNoDashboardFR ( 29 ) {
				text = "O Dashboard de Monitoramento deve exibir os dados de todos os sensores em tempo real, com uma taxa de atualizacao de no mınimo 200ms, permitindo acompanhamento contınuo do estado dos pacientes."
			}
		}
	} 
} 
 






















package SysADL.Components { 
	import SysADL.Ports;
	import SysADL.types;
	import SysADL.Connectors;
	
	boundary
	
	component def ProcessadorLocalCP {
		ports :
			entradaDados : SinalVitalIPT ;
			saidaRedeInterna : MensagemRedeOPT ;
			disparoAlarme : ComandoAlertaOPT ;
			entradaRegrasInterna : RegraIPT ;
			saidaMetricaInterna : MetricaOPT ;
	}
	
	component def AnaliseRiscoCP {
		ports :
			entradaAnalise : TopicoVitalIPT ;
			triggerAlerta : TopicoAlertaOPT ;
			dadosPersistencia : PersistenciaOPT ;
			chamadaLogica : LogicaIPT ;
	}
	
	component def SensorCP {
		ports :
			saidaSinal : SinalVitalOPT ; 
		configuration {
			components :
			
				DriverSensor : DriverSensorCP {}
			}
	} boundary
	
	component def MonitorLeitoCP {
			ports :
				entradaSinal : SinalVitalIPT ;
				
				saidaRede : MensagemRedeOPT ;
				
				comandoAlarme : ComandoAlertaOPT ;
				
				entradaRegras : RegraIPT ;
				
				saidaMetrica : MetricaOPT ;
		configuration {
			components :
			
				DriverSensor : DriverSensorCP {
					using ports :
						rawInput : SinalVitalIPT;
						digitalOut : SinalVitalOPT;
				}

				Buffer : BufferLocalCP {
					using ports :
						dataIn : SinalVitalIPT;
						dataOut : SinalVitalOPT;
				}
				
				Processador : ProcessadorLocalCP {
					using ports :
						entradaDados : SinalVitalIPT ;
						entradaRegrasInterna : RegraIPT ;
						saidaRedeInterna : MensagemRedeOPT ;
						disparoAlarme : ComandoAlertaOPT ;
						saidaMetricaInterna : MetricaOPT ;
				}
				connectors :
				
				
				cInterno1 : FioFisicoCN bindings digitalOut = dataIn;
				
				
				cInterno2 : FioFisicoCN bindings dataOut = entradaDados;
				
			delegations :
				
				
				rawInput to entradaSinal
				
				
				saidaRedeInterna to saidaRede
				
				
				disparoAlarme to comandoAlarme
				
				saidaMetricaInterna to saidaMetrica
			}
			
	} boundary
	
	component def LoggerAuditoriaCP {
		ports :
			entradaLog : PersistenciaIPT ;
			saidaLog : PersistenciaOPT ;
	}
	
	component def MotorNotificacaoCP {
		ports :
			entradaTrigger : TopicoAlertaIPT ;
			publicaNotificacao : TopicoAlertaOPT ;
	}
	
	component def AdaptadorHISCP {
		ports :
			conexaoHIS : IntegracaoOPT ;
	}
	
	component def BufferLocalCP {
		ports :
			dataIn : SinalVitalIPT ;
			dataOut : SinalVitalOPT ;
	}
	
	component def DriverSensorCP {
		ports :
			rawInput : SinalVitalIPT ;
			digitalOut : SinalVitalOPT ;
	}
	
	component def DispositivoAlertaCP {
		ports :
			entradaComando : ComandoAlertaIPT ;
	} boundary
	
	component def MonitoringDashboardCP { 
		ports :
			assinaturaAlerta : TopicoAlertaIPT ;
			consultaDB : QueryOPT ;
			solicitaAuth : AuthOPT ;
			saidaHIS : IntegracaoOPT ;
		configuration {
			components :
				
				LoggerAuditoria : LoggerAuditoriaCP {}
				AdaptadorHIS : AdaptadorHISCP {}
			}
	}
    
    component def ColetorCP { 
    	ports :
    		entradaRede : MensagemRedeIPT ;
    		publicacao : TopicoVitalOPT ;
    		saidaMetrica : MetricaOPT ;
    	configuration { }
    }
    
    component def AlertProcessorCP { 
    	ports :
    		entradaFila : TopicoVitalIPT ;
    		publicaAlerta : TopicoAlertaOPT ;
    		persistencia : PersistenciaOPT ;
    		saidaMetrica : MetricaOPT ;
    		
    	configuration {
			components :
				
				AnaliseRisco : AnaliseRiscoCP {
					using ports :
						entradaAnalise : TopicoVitalIPT ;
						triggerAlerta : TopicoAlertaOPT ;
						dadosPersistencia : PersistenciaOPT ;
						chamadaLogica : LogicaIPT ;
				}

				MotorNotificacao : MotorNotificacaoCP {
					using ports :
						entradaTrigger : TopicoAlertaIPT ;
						publicaNotificacao : TopicoAlertaOPT ;
				}
				
				LoggerAuditoria : LoggerAuditoriaCP {
					using ports :
						entradaLog : PersistenciaIPT ;
						saidaLog : PersistenciaOPT ;
				}
				
				LogicaMedica : LogicaMedicaCP {
                    using ports :
                        executaRegra : LogicaOPT ;
                }

			connectors :
			
				c_logica : ChamadaLogicaCN bindings executaRegra = chamadaLogica ;
				
				c_alerta : StreamingAlertaCN bindings triggerAlerta = entradaTrigger ;
				
				c_persistencia : PersistenciaCN bindings dadosPersistencia = entradaLog ;
				
			delegations :
				
				entradaAnalise to entradaFila
				
				publicaNotificacao to publicaAlerta
				
				saidaLog to persistencia
			}
	}
    
    component def AuthServiceCP {
    	ports :
    		entradaAuth : AuthIPT ; 
    	configuration {
			components :
			
				LoggerAuditoria : LoggerAuditoriaCP {}
			} 
	}
    
    component def LogicaMedicaCP { 
    	ports :
    		distribuicaoRegras : RegraOPT ;
    		executaRegra : LogicaOPT ;
    	configuration { }
    }
    
    component def MessageBrokerCP { 
    	ports :
    		
    		entradaDados : TopicoVitalIPT ;
    		saidaDados : TopicoVitalOPT ;
    		
    		
    		entradaAlerta : TopicoAlertaIPT ;
    		saidaAlerta : TopicoAlertaOPT ;
    	configuration { }
    }
    
    component def DatabaseCP { 
    	ports :
    		entradaGravacao : PersistenciaIPT ;
    		entradaConsulta : QueryIPT ;
    	configuration { }
    }

    
    component def SysADLPulseNet {
    	configuration {
    		components :
    			Coletor : ColetorCP {
    				using ports :
    					entradaRede : MensagemRedeIPT ;
    					publicacao : TopicoVitalOPT ;
    			}
    			MessageBroker : MessageBrokerCP {
    				using ports :
    					entradaDados : TopicoVitalIPT ;
    					saidaDados : TopicoVitalOPT ;
    					entradaAlerta : TopicoAlertaIPT ;
    					saidaAlerta : TopicoAlertaOPT ;
    			}
    			AlertProcessor : AlertProcessorCP {
    				using ports :
    					entradaFila : TopicoVitalIPT ;
    					publicaAlerta : TopicoAlertaOPT ;
    					persistencia : PersistenciaOPT ;
    			}
    			LogicaMedica : LogicaMedicaCP {}
    			Database : DatabaseCP {
    				using ports :
    					entradaGravacao : PersistenciaIPT ;
    			}
    			AuthService : AuthServiceCP {}
    			MonitoringDashboard : MonitoringDashboardCP {
    				using ports :
    					assinaturaAlerta : TopicoAlertaIPT ;
    			}
    			DispositivoAlerta : DispositivoAlertaCP {
    				using ports :
    					entradaComando : ComandoAlertaIPT ;
    			}
    			MonitorLeito : MonitorLeitoCP {
    				using ports : 
    					entradaSinal : SinalVitalIPT ;
    					saidaRede : MensagemRedeOPT ;
    					comandoAlarme : ComandoAlertaOPT ;
    			}
    			Sensor : SensorCP {
    				using ports : 
    					saidaSinal : SinalVitalOPT ;
    			}
    		
    		connectors :
				
				c1 : FioFisicoCN bindings saidaSinal = entradaSinal ;
			
				c2 : AtuacaoCN bindings comandoAlarme = entradaComando ;
					
				c3 : RedeHospitalarCN bindings saidaRede = entradaRede ;
					
				c4 : StreamingVitalCN bindings publicacao = entradaDados ;
					
				c5 : StreamingVitalCN bindings saidaDados = entradaFila ;
					
				c6 : StreamingAlertaCN bindings publicaAlerta = entradaAlerta ;
					
				c7 : PersistenciaCN bindings persistencia = entradaGravacao ;
				
				c8 : StreamingAlertaCN bindings saidaAlerta = assinaturaAlerta ;
    	
    	}

     	
    } 
 } 

package SysADL.types { 
    value type Int { } 
    value type Boolean { } 
    value type String { } 
    value type Void { } 
    value type Real { } 
    dimension pressao 
    dimension tempo 
    dimension percentual 
    dimension frequencia 
    dimension identificador 
    unit porcentagem 
    unit bpm 
    unit mmHG 
    unit idUnit 
    unit dataHoraUnit 
    value type dataHora {unit = dataHoraUnit dimension = tempo} 
    value type oxigenacaoSanguinea {unit = porcentagem dimension = percentual} 
    value type idSensor {unit = idUnit dimension = identificador}
    value type idPaciente {unit = idUnit dimension = identificador} 
    value type idLeito {unit = idUnit dimension = identificador}
    value type batimentosCardiacos {unit = bpm dimension = frequencia}
    value type pressaoDiastolica {unit = mmHG dimension = pressao}
    value type pressaoSistolica {unit = mmHG dimension = pressao} 
    datatype ChamadaRegras { }
    datatype pressaoArterial { 
        attributes : pressaoSistolica : pressaoSistolica;
                     pressaoDiastolica : pressaoDiastolica;
    }
    datatype mensagemSensor { 
        attributes : oxigenacao : oxigenacaoSanguinea;
                     batimentos : batimentosCardiacos;
                     pressao : pressaoArterial;
                     dataHora : dataHora; 
                      
    } 
    datatype mensagemColetor { 
        attributes : leito : idLeito;
                     leitura : mensagemSensor; 
    } 
    datatype alertaDeRisco { 
        attributes : alertaNivel : AlertaNivel;
                     idPaciente : idPaciente;
                     idLeito : idLeito;
                     idSensor : idSensor; 
                      
    }  
    datatype paciente { 
        attributes : id : idPaciente;
                     nome : String;
dataNascimento : dataHora;
    }
    datatype leito { 
        attributes : id : idLeito;
                     numero : Int;
                     setor : String;
    }
    datatype regraDeMonitoramento { 
        attributes : tipoSinal : tipoDeSensor;
                     janelaTemporal : dataHora;
                     habilitado : Boolean;
    }
    enum AlertaNivel { NORMAL, ATENCAO, CRITICO } 
    enum tipoDeSensor { OXIGENACAO, BATIMENTO, PRESSAO, ECG }
     
    datatype metricaInfra {
        attributes :
            nome : String ;
            valor : Real ;
            timestamp : dataHora ;
    }
}

package SysADL.Ports {
	
	import SysADL.types;

	port def LogicaIPT {
	flow in ChamadaRegras
	}
	port def LogicaOPT {
		flow out ChamadaRegras
	}
	
	port def SinalVitalOPT {
		flow out mensagemSensor
	}
	port def SinalVitalIPT {
		flow in mensagemSensor
	}

	port def MensagemRedeOPT {
		flow out mensagemColetor
	}
	port def MensagemRedeIPT {
		flow in mensagemColetor
	}
	
	port def TopicoVitalOPT { 
		flow out mensagemColetor
	}
	port def TopicoVitalIPT { 
		flow in mensagemColetor
	}
	
	port def TopicoAlertaOPT { 
		flow out alertaDeRisco
	}
	port def TopicoAlertaIPT { 
		flow in alertaDeRisco
	}

	port def IntegracaoOPT {
		flow out paciente
	}
	port def IntegracaoIPT {
		flow in paciente
	}

	port def PersistenciaOPT {
        flow out mensagemColetor
    }
    port def PersistenciaIPT {
        flow in mensagemColetor
    }

	port def QueryOPT {
		flow out String
	}
	port def QueryIPT {
		flow in String
	}


	port def AuthOPT {
		flow out String
	}
	port def AuthIPT {
		flow in String
	}

	port def AlertaOPT {
		flow out alertaDeRisco
	}
	port def AlertaIPT {
		flow in alertaDeRisco
	}


	port def ComandoAlertaOPT {
		flow out Boolean
	}
	port def ComandoAlertaIPT {
		flow in Boolean
	}


	port def RegraIPT {
		flow in regraDeMonitoramento
	}
	port def RegraOPT {
		flow out regraDeMonitoramento
	}
	

	port def MetricaIPT {
        flow in metricaInfra
    }
    port def MetricaOPT {
        flow out metricaInfra
    }
}

package SysADL.Connectors {
	import SysADL.Ports;
	import SysADL.types;


	connector def FioFisicoCN {
		participants : ~src : SinalVitalOPT; ~dst : SinalVitalIPT;
		flows : mensagemSensor from src to dst
	}
	connector def AtuacaoCN {
		participants : ~src : ComandoAlertaOPT; ~dst : ComandoAlertaIPT;
		flows : Boolean from src to dst
	}


	connector def RedeHospitalarCN {
		participants : ~src : MensagemRedeOPT; ~dst : MensagemRedeIPT;
		flows : mensagemColetor from src to dst
	}

	connector def StreamingVitalCN {
		participants : ~src : TopicoVitalOPT; ~dst : TopicoVitalIPT;
		flows : mensagemColetor from src to dst
	}


	connector def StreamingAlertaCN {
		participants : ~src : TopicoAlertaOPT; ~dst : TopicoAlertaIPT;
		flows : alertaDeRisco from src to dst
	}

	connector def PersistenciaCN {
		participants : ~src : PersistenciaOPT; ~dst : PersistenciaIPT;
		flows : mensagemColetor from src to dst
	}
	connector def ChamadaLogicaCN {
		participants : ~src : LogicaOPT; ~dst : LogicaIPT;
		flows : ChamadaRegras from src to dst
	}
}
 

package SysADL.Activities {
	import SysADL.types;     
	  
	action def LerMensagemSensores ( msg : mensagemSensor , leito : idLeito ) : mensagemColetor { constraint : post-condition LerMensagemSensorEQ delegate LerMensagemSensores to msgOC delegate msg to msgS delegate leito to idS } 
	action def AvaliarCriticidadeLeito ( regras : regraDeMonitoramento , msgAv : mensagemColetor ) : AlertaNivel { constraint : post-condition AvaliaCriticidadeLeituraEQ delegate regras to rAv delegate msgAv to msgAvC delegate AvaliarCriticidadeLeito to alertNvl } 
	action def ExibirEstadoEmMonitorDoLeito ( alerta : AlertaNivel ) : Void { constraint : post-condition AlertarMonitorEQ delegate ExibirEstadoEmMonitorDoLeito to void delegate alerta to alertRisco } activity def ProcessarLeitura ( m1 : mensagemSensor ) ( l1 : idLeito ) ( r1 : regraDeMonitoramento ) : ( void : Void ) { body { actions : LerMensagemSensores : LerMensagemSensores { using pins : msg : mensagemSensor ; leito : idLeito ; } PublicarEmFilaComRetry : PublicarEmFilaComRetry { using pins : msgC : mensagemColetor ; } ExibirEstadoEmMonitorDoLeito : ExibirEstadoEmMonitorDoLeito { using pins : alerta : AlertaNivel ; } AvaliarCriticidadeLeito : AvaliarCriticidadeLeito { using pins : regras : regraDeMonitoramento ; msgAv : mensagemColetor ; } delegate m1 to msg delegate l1 to leito flow from LerMensagemSensores to msgC delegate void to ExibirEstadoEmMonitorDoLeito flow from PublicarEmFilaComRetry to msgAv delegate r1 to regras flow from AvaliarCriticidadeLeito to alerta } } 
	 
	action def PublicarEmFilaComRetry ( msgC : mensagemColetor ) : mensagemColetor { constraint : post-condition EnfileirarMensagemEQ delegate msgC to msgFila delegate PublicarEmFilaComRetry to msgEnfileirada } constraint AvaliaCriticidadeLeituraEQ ( rAv : regraDeMonitoramento , msgAvC : mensagemColetor ) : ( alertNvl : AlertaNivel ) { } constraint LerMensagemSensorEQ ( idS : idSensor , msgS : mensagemSensor ) : ( msgOC : mensagemColetor ) { } constraint EnfileirarMensagemEQ ( msgFila : mensagemColetor ) : ( msgEnfileirada : mensagemColetor ) { } constraint AlertarMonitorEQ ( alertRisco : alertaDeRisco ) : ( void : Void ) { } }