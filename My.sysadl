Model SysADLModel ; 
package SysADL.Components { boundary
	
	component def SensorCP { 
		configuration {
			components :
			
				DriverSensor : DriverSensorCP {}
			}
	} boundary
	
	component def MonitorLeitoCP {
		configuration {
			components :
			
				Buffer : BufferLocalCP {}
				DriverSensor : DriverSensorCP {}
			}
			
	} boundary
	
	component def LoggerAuditoriaCP {}
	
	component def MotorNotificacaoCP {}
	
	component def AdaptadorHISCP {}
	
	component def BufferLocalCP {}
	
	component def DriverSensorCP {}
	
	component def DispositivoAlertaCP { } boundary
	
	component def MonitoringDashboardCP { 
		configuration {
			components :
				
				LoggerAuditoria : LoggerAuditoriaCP {}
				AdaptadorHIS : AdaptadorHISCP {}
			}
	}
    
    component def ColetorCP { configuration { } }
    
    component def AlertProcessorCP { 
    	configuration {
			components :
				
				LoggerAuditoria : LoggerAuditoriaCP {}
				MotorNotificacao : MotorNotificacaoCP {}
			}
	}
    
    component def AuthServiceCP { 
    	configuration {
			components :
			
				LoggerAuditoria : LoggerAuditoriaCP {}
			} 
	}
    
    component def LogicaMedicaCP { configuration { } }
    
    component def MessageBrokerCP { configuration { } }
    
    component def DatabaseCP { configuration { } }

    
    component def SysADLPulseNet {
    	configuration {
    		components :
    			Coletor : ColetorCP {}
    			MessageBroker : MessageBrokerCP {}
    			AlertProcessor : AlertProcessorCP {}
    			LogicaMedica : LogicaMedicaCP {}
    			Database : DatabaseCP {}
    			AuthService : AuthServiceCP {}
    			MonitoringDashboard : MonitoringDashboardCP {}
    			DispositivoAlerta : DispositivoAlertaCP {}
    			MonitorLeito : MonitorLeitoCP {}
    			Sensor : SensorCP {}
    	}

     	
    } 
 } 

package SysADL.types { 
    value type Int { } 
    value type Boolean { } 
    value type String { } 
    value type Void { } 
    value type Real { } 
    dimension pressao 
    dimension tempo 
    dimension percentual 
    dimension frequencia 
    dimension identificador 
    unit porcentagem 
    unit bpm 
    unit mmHG 
    unit idUnit 
    unit dataHoraUnit 
    value type dataHora {unit = dataHoraUnit dimension = tempo} 
    value type oxigenacaoSanguinea {unit = porcentagem dimension = percentual} 
    value type idSensor {unit = idUnit dimension = identificador}
    value type idPaciente {unit = idUnit dimension = identificador} 
    value type idLeito {unit = idUnit dimension = identificador}
    value type batimentosCardiacos {unit = bpm dimension = frequencia}
    value type pressaoDiastolica {unit = mmHG dimension = pressao}
    value type pressaoSistolica {unit = mmHG dimension = pressao} 
    datatype pressaoArterial { 
        attributes : pressaoSistolica : pressaoSistolica;
                     pressaoDiastolica : pressaoDiastolica;
    }
    datatype mensagemSensor { 
        attributes : oxigenacao : oxigenacaoSanguinea;
                     batimentos : batimentosCardiacos;
                     pressao : pressaoArterial;
                     dataHora : dataHora; 
                      
    } 
    datatype mensagemColetor { 
        attributes : leito : idLeito;
                     leitura : mensagemSensor; 
    } 
    datatype alertaDeRisco { 
        attributes : alertaNivel : AlertaNivel;
                     idPaciente : idPaciente;
                     idLeito : idLeito;
                     idSensor : idSensor; 
                      
    }  
    datatype paciente { 
        attributes : id : idPaciente;
                     nome : String;
dataNascimento : dataHora;
    }
    datatype leito { 
        attributes : id : idLeito;
                     numero : Int;
                     setor : String;
    }
    datatype regraDeMonitoramento { 
        attributes : tipoSinal : tipoDeSensor;
                     janelaTemporal : dataHora;
                     habilitado : Boolean;
    }
    enum AlertaNivel { NORMAL, ATENCAO, CRITICO } 
    enum tipoDeSensor { OXIGENACAO, BATIMENTO, PRESSAO, ECG } 
}
 
Requirement MonitorElectrocardiogramCP ( 4 ) { derive MonitorPatientDataFR ; } 
Requirement MonitoBloodPresureCP ( 5 ) { derive MonitorPatientDataFR ; } 
Requirement MonitorPatientDataFR ( 3 ) { text = "Monitores the patient health data" } 
Requirement MonitorHeardRateCP ( 7 ) { derive MonitorPatientDataFR ; } 
Requirement MonitorRespiratoryRateCP ( 6 ) { derive MonitorPatientDataFR ; }


 
 
 

Requirement QualityNFR ( 91 ) { } 
Requirement ModifiabilityNFR ( 92 ) { text = "The system must be easy and cheap to improve and modify" derive QualityNFR ; } 
Requirement ScalabilityNFR ( 94 ) { text = " The System must be scalable to be able to process bigger data volumes and deal with more patients and sensors " derive QualityNFR ; } 
Requirement AvailabiltyNFR ( 93 ) { text = "The system can not break down, it must be always working" derive QualityNFR ; } 
Requirement FallbackNFR ( 95 ) { text = "The system must have a fallback device in case it fails, so even with down times the essential functionalities still work" derive AvailabiltyNFR ; } 
Requirement SecurityNFR ( 96 ) { text = "The system must be safe" derive QualityNFR ; } 
Requirement CriptografyNFR ( 97 ) { text = "All the patient data must be encrypted to assure safety and privacy" derive SecurityNFR ; } 
Requirement AuthenticationNFR ( 98 ) { text = "All users must be authenticated before accessing data or receive alert notifications to avoid non allowed users to receive private patient data" derive SecurityNFR ; } 
Requirement ConfiabilityNFFR ( 99 ) { text = "The essential system features must work even with system failure " derive QualityNFR ; }Requirement MedicalDashboardCP ( 100 ) { derive ReadPatientData ; } Requirement SavePatientData ( 101 ) { text = "Save patient data " derive MonitorPatientDataFR ; } Requirement ReadPatientData ( 102 ) { derive SavePatientData ; } Requirement MedicalAlertServiceFR ( 103 ) { derive ReadPatientData ; }