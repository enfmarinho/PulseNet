Model SysADLModel ; package SysADL.types { value type Int { } value type Boolean { } value type String { } value type Void { } value type Real { } } package newElement { } Requirement Requisitos ( 8 ) { Requirement RequisitosNaoFuncionais ( 10 ) { Requirement SegurancaNFR ( 46 ) { Requirement AuditoriaNFR ( 49 ) { text = "Todas as acoes de usuarios e alertas devem ser registradas com timestamp, ID do usuario e origem." } Requirement AutenticacaoNFR ( 45 ) { text = "Somente usuarios autenticados podem acessar dados do paciente." } Requirement CripitografiaDosDadosNFR ( 48 ) { text = "Dados de pacientes devem ser armazenados de forma criptografada." } Requirement AutorizacaoNFR ( 47 ) { text = "Funcoes sensıveis, como alteracao de leitos, devem seguir nıvel de permissao da equipe medica." } } Requirement ConfiabilidadeNFR ( 50 ) { Requirement TaxaMaximaDeFalhasNFR ( 51 ) { text = "O sistema deve operar com taxa de falhas recuperaveis inferior a 0,1%\ndas mensagens." } Requirement IntegridadeDosDadosNFR ( 52 ) { text = "Nenhuma leitura de sinal vital pode ser descartada sem log ou justificativa." } Requirement DetecaoDeFalhasNFR ( 53 ) { text = "Monitores devem enviar heartbeats; falhas devem ser detectadas em ≤ 10\nsegundos" } } Requirement DisponibilidadeNFR ( 34 ) { Requirement RetentativaDeEnvioNFR ( 37 ) { text = "Se a mensagem do sensor nao for entregue, o sistema deve reenviar a leitura ate um limite configurado." } Requirement BufferLocalNoLeitoNFR ( 38 ) { text = "Ao perder comunicacao com a rede, o monitor do leito deve armazenar localmente dados por no mınimo 5 minutos." } Requirement DisponibilidadeDoSistemaNFR ( 35 ) { text = "O sistema deve manter disponibilidade contınua mınima de 99,5%, garantindo\nmonitoramento ininterrupto." } Requirement MensageriaConfiavelNFR ( 39 ) { text = "A mensageria deve enviar apenas mensagens validas " } Requirement FallbackDeColetaNFR ( 36 ) { text = "Caso o coletor principal falhe, um coletor de fallback deve assumir automaticamente a captura dos dados do leito." } } Requirement EscalabilidadeDesempenhoNFR ( 40 ) { Requirement EscalabilidadeHorizontalNFR ( 41 ) { text = "Os servicos de mensageria, alerta e dashboard devem suportar instancias multiplas em balanceamento de carga." } Requirement AumentoDeLeitosNFR ( 42 ) { text = "A arquitetura deve permitir crescimento para 3× o numero atual de leitos sem redesenho estrutural" } Requirement ProcessamentoEmFilaNFR ( 43 ) { text = "A solucao deve processar picos de mensagens sem perda, suportando ao menos 300 mensagens/s por enfermaria" } Requirement AcessoRapidoAosDadosNFR ( 44 ) { text = "Os dados e alertas devem estar disponiveis no sistema rapidamente" } } Requirement ModificabilidadeManutenibilidadeNFR ( 32 ) { Requirement ModularidadeNFR ( 33 ) { text = "Sensores, coletores, servicos e dashboards devem ser substituıveis sem impacto nas demais camadas. A logica medica deve ser isolada em um componente especıfico, permitindo alteracao sem modificar a infraestrutura." } } Requirement UsabilidadeNFR ( 56 ) { Requirement AcessibilidadeNFR ( 55 ) { text = "Dashboard com contraste alto, teclas de atalho e sem dependencia exclu-\nsiva de cores." } Requirement InterfaceIntuitivaNFR ( 54 ) { text = "O dashboard deve exibir informacoes prioritarias com foco em situacao crıtica" } } } Requirement RequisitosFuncionais ( 9 ) { Requirement ColetaSinaisVitaisFR ( 7 ) { text = "" Requirement ColetarEletrocardiogramaFR ( 4 ) { text = "O sistema deve coletar dados de sensores de eletrocardiograma com periodicidade mınima de uma vez por segundo. " } Requirement ColetarOxigenacaoSanguineaFR ( 3 ) { text = "O sistema deve coletar dados de sensores de oxigenacao sanguınea com periodicidade mınima de uma vez por segundo. " } Requirement ColetarFrequenciaCardiacaFR ( 1 ) { text = "O sistema deve coletar dados de sensores de frequencia cardıaca com periodicidade mınima de uma vez por segundo." } Requirement ColetarPressaoArterialFR ( 2 ) { text = "O sistema deve coletar dados de sensores de pressao arterial com periodicidade mınima de uma vez por segundo. " } Requirement ColetarTemperaturaCorporalFR ( 5 ) { text = "O sistema deve coletar dados de sensores de temperatura corporal com periodicidade mınima de uma vez por segundo. Requisito opcional, mas comum em unidades de terapia intensiva. " } Requirement RegistrarTimestandDaLeituraFR ( 6 ) { text = "O sistema deve registrar o timestamp de cada leitura realizada pelos sensores para garantir rastreabilidade e ordenacao cronologica dos dados. " } } Requirement TransmissaoDadosDosLeitoFR ( 11 ) { Requirement EnviarDadosDoSensorParaColetorFR ( 12 ) { text = "Cada sensor deve enviar suas leituras para o coletor com uma periodicidade de no mınimo uma vez por segundo." } Requirement ReenviarDadosEmCasoDeFalhaFR ( 14 ) { text = "Em caso de falha de um coletor, o sistema deve ter um mecanismo de fallback automatico, garantindo a continuidade da operacao de ingestao de dados. Os dados devem ser reenviados automaticamente quando a conexao for restabelecida." } Requirement ValidarFormatoDaMensagemDoSensorFR ( 13 ) { text = "O sistema deve validar o formato da mensagem recebida do sensor antes\ndo processamento, garantindo integridade e conformidade com o protocolo definido." } Requirement GarantirOrdemCronologicaDaTransmissaoFR ( 15 ) { text = "O sistema deve garantir que os dados sejam transmitidos e processados\nmantendo a ordem cronologica das leituras, preservando a sequencia temporal dos eventos." } } Requirement ProcessamentoDeDadosFR ( 16 ) { Requirement NormalizarDadosDeSinaisVitaisFR ( 17 ) { text = "O coletor deve normalizar os dados de sinais vitais recebidos dos sensores, padronizando formatos e unidades de medida para processamento uniforme" } Requirement ConsumirDadosDaFilaFR ( 20 ) { text = "A arquitetura da mensageria deve gerenciar o paralelismo interno para processar multiplos streams de dados simultaneamente, evitando gargalos. Os gateways devem consumir dados da fila de forma eficiente." } Requirement PersistirDadosNoBancoFR ( 21 ) { text = "O sistema deve persistir todas as leituras de sinais vitais no banco de dados para historico, analise e auditoria, garantindo integridade e disponibilidade dos dados." } Requirement ArmazenarLeituraEmBufferSeguroFR ( 18 ) { text = "O coletor deve processar dados em tempo real, com latencia maxima de\n500ms da leitura do sensor ate o processamento inicial. Os dados devem ser armazenados temporariamente em buffer seguro durante o processamento." } Requirement PublicarLeituraNaFilaDeMensageriaFR ( 19 ) { text = "A mensageria deve agrupar sensores em clusters de alto volume (Cluster 1) e clusters de baixa carga (Cluster 2) para otimizacao do fluxo de dados. Cada sensor deve publicar seus dados em topicos especıficos, utilizando uma chave de leitura para identificacao e roteamento" } } Requirement AvaliacaoClinicaFR ( 22 ) { Requirement DetectarLimiarDeRiscoFR ( 23 ) { text = "A Logica Medica deve avaliar os criterios de medicao e detectar condicoes crıticas baseadas nos limiares calculados e nas leituras dos sensores." } Requirement GerarAlertaClinicoAutomaticoFR ( 24 ) { text = "O Servico de Alerta deve monitorar as leituras dos sensores e emitir alertas em menos de 1 segundo apos a deteccao de uma leitura criıtica. O servico deve suportar fallback em caso de falha, garantindo que a emissao de alertas nao seja interrompida." } Requirement EnviarComandoDeAlertaParaDispositivosFR ( 25 ) { text = "O sistema deve enviar comandos para acionar LEDs e alarmes sonoros que indiquem o estado do paciente, baseado na classificacao do alerta gerado." } } Requirement MonitorDoLeitoFR ( 27 ) { Requirement ExibirDadosEmTempoRealNoMonitoFR ( 26 ) { text = "O Monitor do Leito deve exibir os dados de todos os sensores em tempo real, com uma taxa de atualizacao de no mınimo 200ms, permitindo acompanhamento contınuo do estado do paciente." } } Requirement InterfaceGrafica ( 28 ) { Requirement ExibirAlertasEmTempoRealFR ( 31 ) { text = "O dashboard deve exibir alertas em tempo real, destacando visualmente os alertas crıticos e de atencao, com informacoes sobre o leito, paciente e tipo de alerta." } Requirement ListarHistoricoDeSinaisVitaisFR ( 30 ) { text = "O sistema deve permitir a visualizacao do historico de sinais vitais de cada paciente, com filtros por data, hora e tipo de sinal, facilitando analise retrospectiva." } Requirement ExibirDadosEmTempoRealNoDashboardFR ( 29 ) { text = "O Dashboard de Monitoramento deve exibir os dados de todos os sensores em tempo real, com uma taxa de atualizacao de no mınimo 200ms, permitindo acompanhamento contınuo do estado dos pacientes." } } } }