ao for restabelecida." } Requirement ValidarFormatoDaMensagemDoSensorFR ( 13 ) { text = "O sistema deve validar o formato da mensagem recebida do sensor antes\ndo processamento, garantindo integridade e conformidade com o protocolo\ndefinido." } Requirement GarantirOrdemCronologicaDaTransmissaoFR ( 15 ) { text = "O sistema deve garantir que os dados sejam transmitidos e processados\nmantendo a ordem cronol´ogica das leituras, preservando a sequˆencia tem-\nporal dos eventos." } } Requirement ProcessamentoDeDadosFR ( 16 ) { Requirement NormalizarDadosDeSinaisVitaisFR ( 17 ) { text = "O coletor deve normalizar os dados de sinais vitais recebidos dos sensores, padronizando formatos e unidades de medida para processamento uniforme" } Requirement ConsumirDadosDaFilaFR ( 20 ) { text = "A arquitetura da mensageria deve gerenciar o paralelismo interno para\nprocessar m´ultiplos streams de dados simultaneamente, evitando gargalos.\nOs gateways devem consumir dados da fila de forma eficiente." } Requirement PersistirDadosNoBancoFR ( 21 ) { text = "O sistema deve persistir todas as leituras de sinais vitais no banco de dados para historico, analise e auditoria, garantindo integridade e disponibilidade dos dados." } Requirement ArmazenarLeituraEmBufferSeguroFR ( 18 ) { text = "O coletor deve processar dados em tempo real, com latˆencia m´axima de\n500ms da leitura do sensor at´e o processamento inicial. Os dados devem ser\narmazenados temporariamente em buffer seguro durante o processamento." } Requirement PublicarLeituraNaFilaDeMensageriaFR ( 19 ) { text = "A mensageria deve agrupar sensores em clusters de alto volume (Cluster\n1) e clusters de baixa carga (Cluster 2) para otimiza¸c˜ao do fluxo de dados.\nCada sensor deve publicar seus dados em t´opicos espec´ıficos, utilizando\numa chave de leitura para identifica¸c˜ao e roteamento" } } Requirement AvaliacaoClinicaFR ( 22 ) { Requirement DetectarLimiarDeRiscoFR ( 23 ) { text = "A L´ogica M´edica deve avaliar os crit´erios de medi¸c˜ao e detectar condi¸c˜oes\ncr´ıticas baseadas nos limiares calculados e nas leituras dos sensores." } Requirement GerarAlertaClinicoAutomaticoFR ( 24 ) { text = "O Servi¸co de Alerta deve monitorar as leituras dos sensores e emitir alertas\nem menos de 1 segundo ap´os a detec¸c˜ao de uma leitura cr´ıtica. O servi¸co\ndeve suportar fallback em caso de falha, garantindo que a emiss˜ao de\nalertas n˜ao seja interrompida." } Requirement EnviarComandoDeAlertaParaDispositivosFR ( 25 ) { text = "O sistema deve enviar comandos para acionar LEDs e alarmes sonoros que\nindiquem o estado do paciente, baseado na classifica¸c˜ao do alerta gerado." } } Requirement MonitorDoLeitoFR ( 27 ) { Requirement ExibirDadosEmTempoRealNoMonitoFR ( 26 ) { text = "O Monitor do Leito deve exibir os dados de todos os sensores em tempo\nreal, com uma taxa de atualiza¸c˜ao de no m´ınimo 200ms, permitindo acom-\npanhamento cont´ınuo do estado do paciente." } } Requirement InterfaceGrafica ( 28 ) { Requirement ExibirAlertasEmTempoRealFR ( 31 ) { text = "O dashboard deve exibir alertas em tempo real, destacando visualmente\nos alertas cr´ıticos e de aten¸c˜ao, com informa¸c˜oes sobre o leito, paciente e\ntipo de alerta." } Requirement ListarHistoricoDeSinaisVitaisFR ( 30 ) { text = "O sistema deve permitir a visualiza¸c˜ao do hist´orico de sinais vitais de cada\npaciente, com filtros por data, hora e tipo de sinal, facilitando an´alise\nretrospectiva." } Requirement ExibirDadosEmTempoRealNoDashboardFR ( 29 ) { text = "O Dashboard de Monitoramento deve exibir os dados de todos os sen-\nsores em tempo real, com uma taxa de atualiza¸c˜ao de no m´ınimo 200ms,\npermitindo acompanhamento cont´ınuo do estado dos pacientes." } } } } Requirement ModificabilidadeManutenibilidadeNFR ( 32 ) { Requirement ModularidadeNFR ( 33 ) { text = "Sensores, coletores, servi¸cos e dashboards devem ser substitu´ıveis sem im-\npacto nas demais camadas. A l´ogica m´edica deve ser isolada em um com-\nponente espec´ıfico,